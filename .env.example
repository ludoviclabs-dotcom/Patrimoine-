# Runtime persistence mode. Required in production: FIXTURE or DATABASE.
PERSISTENCE_MODE=FIXTURE

# Required only when PERSISTENCE_MODE=DATABASE.
DATABASE_URL=

# Internal server-side tenant context used before Clerk is integrated in PF-04.
# Never populate these values from browser input or request payloads.
INTERNAL_TENANT_ID=
INTERNAL_IDENTITY_ID=
INTERNAL_TENANT_ROLE=admin
