# Runtime persistence mode. Required in production: FIXTURE or DATABASE.
PERSISTENCE_MODE=FIXTURE

# Required only when PERSISTENCE_MODE=DATABASE.
DATABASE_URL=

# Privileged deployment connection used only by migrations and the explicit
# synthetic demo seed command. Never expose this URL to the application runtime.
DATABASE_ADMIN_URL=
# Dedicated, non-superuser server-only webhook login. It may assume only
# patrimoine_webhook_service; it is never DATABASE_URL or DATABASE_ADMIN_URL.
CLERK_WEBHOOK_DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
ALLOW_DEMO_FIXTURE_SEED=false
# Required in addition to the previous flag if a dedicated production demo
# deployment is intentionally provisioned.
ALLOW_DEMO_FIXTURE_SEED_IN_PRODUCTION=false

# PF-03C checks. These are operator inputs for a dedicated staging database,
# never values submitted by a browser. Smoke writes and restore verification
# refuse production environments.
ALLOW_PF03_SMOKE_WRITE=false
PF03_SMOKE_TENANT_ID=
PF03_SMOKE_IDENTITY_ID=
PF03_SMOKE_ROLE=
PF03_BACKUP_FILE=
ALLOW_PF03_RESTORE=false
PF03_RESTORE_DATABASE_URL=

# Internal server-side tenant context used before Clerk is integrated in PF-04.
# Never populate these values from browser input or request payloads.
INTERNAL_TENANT_ID=
INTERNAL_IDENTITY_ID=
INTERNAL_TENANT_ROLE=admin

# PF-05 private document storage. The blob token grants write access to the
# private container only; no patrimonial object is ever public.
BLOB_READ_WRITE_TOKEN=
# Server-only HMAC secret (>= 32 characters) signing short-lived download
# grants. Rotating it immediately invalidates every outstanding grant.
DOCUMENT_DOWNLOAD_SIGNING_SECRET=
